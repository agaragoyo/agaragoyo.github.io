// Firestore 보안 규칙. 서버에는 이 파일이 저절로 올라가지 않는다. 고쳤으면 Firebase 콘솔의 Firestore > 규칙에
// 이 파일 전체를 붙여 게시한다(known-issues 59). 방 글자 수 한도는 src/cloud.js의 MAX_CODE와,
// 쪽지의 닉네임, 글 글자 수와 색 수는 src/cloud.js의 NOTE와, 아이디의 글자와 길이는 src/cloud.js의 HANDLE_RE와 같아야 한다(tools/check.py가 본다).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공유한 방(#s=<id> 링크). 링크를 아는 사람은 누구나 읽고, 고치기와 지우기는 처음 올린 사람만 한다.
    // 목록 읽기는 막아서 남의 방 번호를 모아 볼 수 없게 한다.
    match /homes/{homeId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && homeId.matches('[0-9A-Za-z]{8}')
        && request.resource.data.uid == request.auth.uid
        && validHome();
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && validHome();
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // 코르크 보드 방명록의 쪽지. 방 링크를 아는 사람은 누구나 읽되, 한 번에 30장까지만 받는다(문서마다 읽기를 센다).
      // 붙이기는 익명 로그인한 누구나 서버에 있는 방에만 하고, 붙인 쪽지는 고치지 못한다.
      // 지우기는 쪽지를 쓴 사람이나 방 주인(방 문서의 uid)이 한다.
      match /notes/{noteId} {
        allow get: if true;
        allow list: if request.query.limit <= 30;
        allow create: if request.auth != null
          && noteId.matches('[0-9A-Za-z]{20}')
          && exists(/databases/$(database)/documents/homes/$(homeId))
          && validNote();
        allow update: if false;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/homes/$(homeId)).data.uid == request.auth.uid);
      }
    }

    // 아이디로 찾아가기. 문서 번호가 아이디(한글, 영문 소문자, 숫자 2~12자)이고, 그 아이디로 찾아갈 방 번호를 담는다.
    // 아이디를 아는 사람은 누구나 한 문서씩 읽되 목록 읽기는 막아서, 아이디를 정한 사람을 모아 볼 수 없게 한다.
    // 만들기는 익명 로그인한 사람이 자기가 올린 방으로만 한다. 이미 있는 아이디는 고치지 못해서 먼저 정한 사람만 쓴다.
    // 지우기는 아이디를 정한 사람만 한다.
    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && handle.matches('[a-z0-9가-힣]{2,12}')
        && validHandle();
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // 아이디 문서에는 uid(정한 사람)와 room(방 번호) 두 칸만 둔다. 방은 서버에 있고 정한 사람이 올린 방이어야 한다.
    function validHandle() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'room'])
        && d.uid == request.auth.uid
        && d.room is string
        && d.room.matches('[0-9A-Za-z]{8}')
        && get(/databases/$(database)/documents/homes/$(d.room)).data.uid == request.auth.uid;
    }

    // 방 문서에는 uid, code(공유 링크의 #r= 뒤와 같은 글자), updatedAt(서버 시각) 세 칸만 둔다.
    function validHome() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'code', 'updatedAt'])
        && d.code is string
        && d.code.size() > 0
        && d.code.size() <= 30000
        && d.updatedAt == request.time;
    }

    // 쪽지 문서에는 uid(쓴 사람), name(닉네임), text(글), color(포스트잇 색 번호), createdAt(서버 시각) 다섯 칸만 둔다.
    function validNote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'text', 'color', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string
        && d.name.trim().size() > 0
        && d.name.size() <= 12
        && d.text is string
        && d.text.trim().size() > 0
        && d.text.size() <= 60
        && d.color is int
        && d.color >= 0
        && d.color <= 3
        && d.createdAt == request.time;
    }
  }
}
